# ---- Core -------------------------------------------------------------------
# Public URL of the site (used for sitemap, canonical URLs, email links)
NEXT_PUBLIC_SITE_URL=https://ai254.net
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai254
# Non-pooled connection for migrations (same as DATABASE_URL if you have no pooler)
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai254
# Long random string (>= 32 chars) used to sign login sessions: `openssl rand -base64 48`
AUTH_SECRET=
# Salt used to hash IP addresses for rate limiting (never stored in plain text)
IP_HASH_SALT=

# ---- Email (SMTP) -----------------------------------------------------------
# If SMTP is not configured, submissions are still saved and the missing email
# is recorded against the submission and in the admin system logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AI254 <no-reply@ai254.net>"
NOTIFY_EMAIL=info@ai254.net

# ---- Spam protection (optional, Cloudflare Turnstile) -----------------------
# Honeypot, timing checks and rate limiting are always active.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- AI254 speech & translation services -----------------------------------
# Leave AI254_ASR_URL empty to run AI254 LIVE in clearly labelled
# demonstration mode with sample lecture content.
#   AI254_ASR_URL        POST audio chunk -> { text, durationMs? }
#   AI254_TRANSLATE_URL  POST { text, subject, glossary } -> { translation, termIds?, durationMs? }
AI254_ASR_URL=
AI254_TRANSLATE_URL=
AI254_API_KEY=

# ---- First administrator (used once by `npm run db:seed`) -----------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
